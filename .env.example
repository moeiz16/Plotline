# Plotline runs fully offline with these defaults. Copy to .env and adjust as needed.
ENVIRONMENT=dev
SECRET_KEY=dev-insecure-change-me-0123456789abcdef
DATABASE_URL=sqlite+aiosqlite:///./plotline-dev.db
PUBLIC_APP_URL=http://localhost:3010
CORS_ORIGINS=["http://localhost:3010"]

# Durable supplier campaigns (local Temporal dev server started by `make temporal`)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=plotline-campaigns
TEMPORAL_WORKER_INLINE=true

# Earth observation: "bundled" = offline synthetic landscape for the demo; "live" = Microsoft Planetary
# Computer (Sentinel-2) + Hansen GFC + EU JRC GFC2020 (needs `pip install -e "backend[eo]"` and network)
EO_SOURCE=bundled
CHANGE_ENCODER_PATH=../ml/artifacts/encoder.npz

# Plain-language summaries: deterministic offline text unless a free-tier key is set
LLM_FAKE=true
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
